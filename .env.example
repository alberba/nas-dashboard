# Valores de ejemplo: el arranque los rechaza. Sustitúyelos por secretos
# aleatorios de al menos 32 caracteres antes de iniciar el hub.
DATABASE_URL=postgresql://hub:change-me@db:5432/hub
POSTGRES_PASSWORD=change-me
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=https://hub.example.com
TRUSTED_ORIGINS=https://hub.example.com
SETUP_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
# Lista de agentes. Mantén el identificador nas-home en el NAS que ya tiene historial.
NAS_HOSTS=[{"id":"nas-home","name":"NAS-HOME","role":"instance","url":"http://your-nas-tailscale-ip:9450","token":"replace-with-a-random-secret-of-at-least-32-characters"},{"id":"apps","name":"Apps","role":"apps-server","url":"http://hub-agent-apps:9450","token":"replace-with-another-random-secret-of-at-least-32-characters"}]
# Compatibilidad con instalaciones de un solo agente: si NAS_HOSTS está vacío,
# se usa esta pareja con el identificador nas-home.
# NAS_AGENT_URL=http://your-nas-tailscale-ip:9450
# AGENT_TOKEN=the-same-secret-as-the-nas-agent
NEXT_PUBLIC_APP_DOMAIN=example.com
BIND_IP=127.0.0.1
PORT=4323
# GitHub en solo lectura para las PR de Renovate. Token fine-grained limitado a
# alberba/media-stack con Pull requests: read, Contents: read y Checks: read.
# Sin token, el hub oculta la sección de Renovate y no llama a GitHub.
# GITHUB_TOKEN=github_pat_replace_with_a_fine_grained_token
# GITHUB_REPOSITORY=alberba/media-stack
# GITHUB_API_URL=https://api.github.com
# Telegram es opcional. Define las dos variables o ninguna; nunca solo una.
# El chat es el identificador numérico del destino (los supergrupos usan un
# valor negativo). Desactivado por defecto.
# TELEGRAM_BOT_TOKEN=123456789:replace-with-the-token-from-botfather
# TELEGRAM_CHAT_ID=-1001234567890

# Claves VAPID opcionales, pero deben definirse juntas. Son obligatorias si
# PUSH_WARNINGS=true.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Push para avisos no urgentes: solo true o false. False por omisión.
# PUSH_WARNINGS=false

# Hora del resumen diario en Europe/Madrid, formato HH:mm de 24 horas. Acepta
# cualquier hora civil del día; no se desplaza con el cambio de hora. Por
# defecto, 08:00.
# DIGEST_TIME=08:00
