{
  "name": "nas-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "node --import ./scripts/eslint-typescript-api.mjs ./node_modules/eslint/bin/eslint.js",
    "typecheck": "tsc --noEmit --incremental false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:agent": "python3 -m unittest discover -s agent -p 'test_*.py'",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx scripts/migrate.ts",
    "worker": "node --env-file-if-exists=.env.local --import tsx src/worker.ts"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.18",
    "@better-auth/passkey": "^1.7.18",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "effect": "^4.1.2",
    "lucide-react": "^1.70.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "^4.23.15",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/turbopack": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.14.0",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@^6.0.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@12.15.0"
}
