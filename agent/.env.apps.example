AGENT_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
BIND_IP=0.0.0.0
# El contenedor solo pertenece a la red privada de Compose del hub.
ALLOWED_IPS=127.0.0.1,172.16.0.0/12
NAS_NAME=Apps
FILES_ENABLED=false
ALLOW_REBOOT=false
PROTECTED_CONTAINERS=nas-dashboard-app-1,nas-dashboard-db-1,nas-dashboard-worker-1,nas-dashboard-migrate-1
# Checkout y estado de media-stack del Servidor de apps, en solo lectura.
MEDIA_STACK_CHECKOUT_PATH=/path/to/media-stack
MEDIA_STACK_APPDATA_PATH=/path/to/media-stack-appdata
# Unidades del rol; por defecto las variantes --apps-server.
# MAINTENANCE_UNITS=media-stack-apps-merged-updates,media-stack-apps-security-updates
# Caché de la instantánea de Despliegues (releases, bloqueos y registro); por defecto 30 s.
# DEPLOYMENTS_CACHE_SECONDS=30
