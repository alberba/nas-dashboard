AGENT_TOKEN=replace-with-a-random-secret-of-at-least-32-characters
BIND_IP=127.0.0.1
ALLOWED_IPS=127.0.0.1
NAS_NAME=NAS
FILES_ENABLED=true
ALLOW_REBOOT=true
# PROTECTED_CONTAINERS=container-a,container-b
NAS_MEDIA_PATH=/path/to/media
NAS_TORRENTS_PATH=/path/to/torrents
# Checkout y estado de media-stack, en solo lectura para la instantánea de mantenimiento.
MEDIA_STACK_CHECKOUT_PATH=/volume2/media-stack
MEDIA_STACK_APPDATA_PATH=/volume2/media-stack-appdata
# Unidades del rol separadas por comas; por defecto las del NAS.
# MAINTENANCE_UNITS=media-stack-merged-updates,media-stack-security-updates,media-stack-evidence,media-stack-tdarr-hardlinks,media-stack-backup
# Caché de la instantánea de Despliegues (releases, bloqueos y registro); por defecto 30 s.
# DEPLOYMENTS_CACHE_SECONDS=30
